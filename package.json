{
  "name": "saju-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",

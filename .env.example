# ─────────────────────────────────────────────────────────────
# 런타임 환경변수 목록 (값은 비워 둔다 — 실제 값은 로컬 .env.local / Cloudflare 시크릿 / GitHub Secrets)
# 이름이 NEXT_PUBLIC_ 으로 시작하면 브라우저 번들에 포함된다 → 공개돼도 되는 값만.
# ─────────────────────────────────────────────────────────────

# Supabase (신규 프로젝트: publishable / secret 키, 구 프로젝트: anon / service_role 키)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=                      # 서버 전용. 절대 NEXT_PUBLIC_ 금지

# Cloudflare Turnstile (개발용 항상 통과 키: 사이트 1x00000000000000000000AA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 카카오 (공유용 JavaScript 키 — 로그인 키는 Supabase 대시보드에 입력)
NEXT_PUBLIC_KAKAO_JS_KEY=

# 포트원 V2
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=                       # 서버 전용
PORTONE_WEBHOOK_SECRET=                   # 서버 전용

# LLM (mock 이면 외부 호출 없음)
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=                              # 서버 전용
LLM_PRICE_INPUT_USD_PER_M=0.75
LLM_PRICE_OUTPUT_USD_PER_M=3.75
USD_KRW=1450
LLM_DAILY_BUDGET_KRW=30000

# 앱
APP_ENV=development                       # development | staging | production
APP_BASE_URL=http://localhost:3000
MERGE_TOKEN_SECRET=                       # 서버 전용, 32바이트 이상 랜덤
ADMIN_USER_IDS=                           # 쉼표 구분 auth user id
SENTRY_DSN=

# 사업자 정보 (전자상거래법 표시 — 법무 페이지·푸터)
BUSINESS_NAME=
BUSINESS_CEO=
BUSINESS_REG_NO=
MAIL_ORDER_REG_NO=
BUSINESS_ADDRESS=
CS_EMAIL=
